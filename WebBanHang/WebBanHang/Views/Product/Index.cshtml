@model IEnumerable<WebBanHang.Models.Product>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold text-dark">Danh Sách Sản Phẩm</h2>
        <a asp-action="Add" class="btn btn-success shadow-sm">+ Thêm Sản Phẩm Mới</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase fs-7 text-secondary border-bottom">
                    <tr>
                        <th scope="col" class="py-3 ps-4" style="width: 15%;">Hình Ảnh</th>
                        <th scope="col" class="py-3" style="width: 15%;">Ảnh Chi Tiết</th>
                        <th scope="col" class="py-3" style="width: 20%;">Tên Sản Phẩm</th>
                        <th scope="col" class="py-3" style="width: 15%;">Giá Bán</th>
                        <th scope="col" class="py-3" style="width: 20%;">Mô Tả</th>
                        <th scope="col" class="py-3" style="width: 15%;">Loại</th>
                        <th scope="col" class="py-3 text-center" style="width: 15%;">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var product in Model)
                        {
                            <tr>
                                <td class="py-3 ps-4">
                                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                                    {
                                        <img src="@product.ImageUrl" alt="@product.Name" class="img-thumbnail shadow-sm" style="width: 80px; height: 60px; object-fit: cover; border-radius: 6px;" />
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center justify-content-center bg-light text-muted border" style="width: 80px; height: 60px; border-radius: 6px; font-size: 0.75rem;">
                                            Không ảnh
                                        </div>
                                    }
                                </td>

                                <td class="py-3">
                                    @if (product.Images != null && product.Images.Any())
                                    {
                                        <div class="d-flex gap-1 flex-wrap">
                                            @foreach (var img in product.Images)
                                            {
                                                <img src="@img.Url" alt="Detail Image" style="width: 40px; height: 30px; object-fit: cover; border-radius: 4px;" class="border shadow-sm" />
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size: 0.8rem;">Không có</span>
                                    }
                                </td>

                                <td class="py-3 fw-semibold text-dark">@product.Name</td>

                                <td class="py-3 text-danger fw-bold">@product.Price.ToString("#,##0") đ</td>

                                <td class="py-3 text-muted text-truncate" style="max-width: 200px;">@product.Description</td>

                                <td class="py-3 text-secondary">@(product.Category?.Name ?? "Chưa phân loại")</td>

                                <td class="py-3 text-center">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Display" asp-route-id="@product.Id" class="btn btn-sm btn-outline-info">Xem</a>
                                        <a asp-action="Update" asp-route-id="@product.Id" class="btn btn-sm btn-outline-warning mx-1">Sửa</a>
                                        <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger">Xóa</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted fs-5">
                                Chưa có sản phẩm nào trong hệ thống.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>