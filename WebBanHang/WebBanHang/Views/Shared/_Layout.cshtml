<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebBanHang</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            background-color: #f4f6f9;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        main {
            flex: 1;
        }

        .navbar-brand {
            font-weight: 800;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .nav-link {
            font-weight: 500;
            transition: color 0.2s ease-in-out;
        }

            .nav-link:hover {
                color: #ffc107 !important;
            }

        .footer {
            background-color: #1a1d20;
            color: #b5b8ba;
        }

            .footer a {
                color: #ffffff;
                text-decoration: none;
                transition: color 0.2s;
            }

                .footer a:hover {
                    color: #ffc107;
                    text-decoration: underline;
                }

        /* Hiệu ứng bóng đổ nhẹ cho navbar */
        .sticky-top {
            backdrop-filter: blur(10px);
            background-color: rgba(33, 37, 41, 0.95) !important;
        }
    </style>
</head>
<body>

    <header class="shadow sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark py-3">
            <div class="container">
                <a class="navbar-brand text-warning d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-lightning-charge-fill"></i> TECH SHOP
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-center">
                        <li class="nav-item">
                            <a class="nav-link text-white d-flex align-items-center gap-1" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door-fill"></i> Trang Chủ
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white-50 d-flex align-items-center gap-1" asp-controller="Product" asp-action="Index">
                                <i class="bi bi-bag-fill"></i> Cửa Hàng
                            </a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white-50" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-grid-fill"></i> Danh Mục
                            </a>
                            <ul class="dropdown-menu border-0 shadow-sm mt-2" aria-labelledby="navbarDropdown">
                                <li><a class="dropdown-content dropdown-item py-2" asp-controller="Product" asp-action="Index"><i class="bi bi-laptop me-2"></i>Điện thoại & Máy tính</a></li>
                                <li><a class="dropdown-content dropdown-item py-2" asp-controller="Product" asp-action="Index"><i class="bi bi-book me-2"></i>Sách & Thiết bị</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-content dropdown-item py-2 text-primary" asp-controller="Product" asp-action="Index">Tất cả danh mục</a></li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white-50 d-flex align-items-center gap-1" asp-controller="Product" asp-action="Add">
                                <i class="bi bi-plus-circle-fill"></i> Đăng Bán Sản Phẩm
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white-50 d-flex align-items-center gap-1" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-info-circle-fill"></i> Giới Thiệu
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white-50 d-flex align-items-center gap-1" asp-controller="Home" asp-action="Privacy">
                                <i class="bi bi-shield-lock-fill"></i> Bảo Mật
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        <form class="d-flex position-relative" role="search" onsubmit="return false;">
                            <input class="form-control me-2 ps-4 rounded-pill border-secondary bg-dark text-white text-sm" type="search" placeholder="Tìm sản phẩm công nghệ..." aria-label="Search" style="width: 250px;">
                            <button class="btn btn-warning rounded-pill px-3 position-absolute end-0 top-0 h-100" type="submit">
                                <i class="bi bi-search"></i>
                            </button>
                        </form>

                        <a href="#" class="text-warning position-relative fs-4 text-decoration-none">
                            <i class="bi bi-cart3"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem;">
                                3
                            </span>
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="py-5">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="footer mt-auto py-5 border-top border-dark">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-5 col-md-6">
                    <h5 class="text-white fw-bold mb-3"><i class="bi bi-lightning-charge-fill text-warning"></i> TECH SHOP SYSTEMS</h5>
                    <p class="small text-secondary lh-lg">
                        Hệ thống thương mại điện tử chuyên nghiệp, cung cấp trải nghiệm mua sắm thiết bị công nghệ vượt trội. Ứng dụng xây dựng trên nền tảng ASP.NET Core MVC và Entity Framework Core kết nối SQL Server hoàn chỉnh.
                    </p>
                </div>

                <div class="col-lg-3 col-md-6 text-lg-center">
                    <h5 class="text-white fw-bold mb-3">Hệ Thống Cửa Hàng</h5>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><a asp-controller="Product" asp-action="Index"><i class="bi bi-chevron-right small text-warning"></i> Xem Sản Phẩm</a></li>
                        <li><a asp-controller="Product" asp-action="Add"><i class="bi bi-chevron-right small text-warning"></i> Đăng Ký Bán</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-12">
                    <h5 class="text-white fw-bold mb-3">Tổng Đài Hỗ Trợ</h5>
                    <p class="small text-secondary mb-2"><i class="bi bi-geo-alt-fill text-warning me-2"></i> Khu Công Nghệ Cao, Quận 9, TP. Hồ Chí Minh</p>
                    <p class="small text-secondary mb-2"><i class="bi bi-envelope-fill text-warning me-2"></i> contact@techshop.com</p>
                    <p class="small text-secondary"><i class="bi bi-telephone-fill text-warning me-2"></i> Hotline phản ánh: 1900 8198</p>
                </div>
            </div>

            <hr class="border-secondary my-4">

            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center small text-secondary">
                <span>&copy; @DateTime.Now.Year - TechShop - Bản quyền thuộc về đồ án ASP.NET Core MVC.</span>
                <div class="d-flex gap-3 mt-2 mt-sm-0 fs-5">
                    <a href="#" class="text-secondary"><i class="bi bi-facebook"></i></a>
                    <a href="#" class="text-secondary"><i class="bi bi-youtube"></i></a>
                    <a href="#" class="text-secondary"><i class="bi bi-github"></i></a>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>