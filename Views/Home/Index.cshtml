@{
    ViewData["Title"] = "Chào Mừng Đến Với Tech Shop";
}

<div class="p-5 mb-4 bg-dark text-white rounded-3 shadow position-relative overflow-hidden" style="background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url('https://images.unsplash.com/photo-1531297484001-80022131f5a1?q=80&w=2020') no-repeat center center; background-size: cover; padding: 100px 20px !important;">
    <div class="container-fluid py-5 position-relative" style="z-index: 2;">
        <span class="badge bg-warning text-dark mb-3 px-3 py-2 text-uppercase fw-bold font-monospace">New Arrival 2026</span>
        <h1 class="display-4 fw-bold text-white mb-3">Chào Mừng Đến Với TECH SHOP</h1>
        <p class="col-md-8 fs-5 text-light opacity-90 mb-4">
            Khám phá không gian mua sắm thiết bị công nghệ đỉnh cao, máy tính cấu hình khủng và linh kiện chính hãng với mức giá ưu đãi nhất thị trường.
        </p>
        <div class="d-flex gap-2">
            <a asp-controller="Product" asp-action="Index" class="btn btn-warning btn-lg px-4 fw-semibold shadow-sm">
                <i class="bi bi-bag-check-fill me-2"></i> Mua Sắm Ngay
            </a>
            <a asp-controller="Home" asp-action="Privacy" class="btn btn-outline-light btn-lg px-4">
                Tìm hiểu thêm
            </a>
        </div>
    </div>
</div>

<div class="row g-4 text-center my-4">
    <div class="col-md-4">
        <div class="p-4 bg-white rounded-3 shadow-sm border-0 h-100">
            <div class="text-warning mb-3"><i class="bi bi-laptop display-4"></i></div>
            <h4 class="fw-bold text-dark">Thiết Bị Cao Cấp</h4>
            <p class="text-muted small mb-0">Cập nhật liên tục các dòng Laptop, Điện thoại, Linh kiện đời mới nhất trên thị trường.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="p-4 bg-white rounded-3 shadow-sm border-0 h-100">
            <div class="text-danger mb-3"><i class="bi bi-tags-fill display-4"></i></div>
            <h4 class="fw-bold text-dark">Giá Cả Cạnh Tranh</h4>
            <p class="text-muted small mb-0">Cam kết giá bán hợp lý đi kèm nhiều chương trình khuyến mãi và quà tặng công nghệ giá trị.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="p-4 bg-white rounded-3 shadow-sm border-0 h-100">
            <div class="text-primary mb-3"><i class="bi bi-patch-check-fill display-4"></i></div>
            <h4 class="fw-bold text-dark">Hệ Thống Hiện Đại</h4>
            <p class="text-muted small mb-0">Hệ thống website quản lý mượt mà, đồng bộ cơ sở dữ liệu thật qua Entity Framework Core.</p>
        </div>
    </div>
</div>