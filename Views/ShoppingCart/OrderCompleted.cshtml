@model int

<div class="container mt-5 text-center" style="max-width: 600px;">
    <div class="card shadow-sm border-0 p-5 rounded-3 bg-white">
        <div class="mb-4">
            <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
        </div>
        <h2 class="fw-bold text-success mb-3">Đặt Hàng Thành Công!</h2>
        <p class="text-muted fs-5 mb-4">
            Cảm ơn bạn đã mua sắm tại TechShop. Đơn hàng của bạn với mã số <strong class="text-dark">#@Model</strong> đã được hệ thống ghi nhận thành công.
        </p>
        <div class="d-grid gap-2 col-8 mx-auto">
            <a asp-controller="Product" asp-action="Index" class="btn btn-dark py-2.5 rounded-pill shadow-sm">
                <i class="bi bi-house-door-fill me-1"></i> Tiếp tục mua hàng
            </a>
        </div>
    </div>
</div>