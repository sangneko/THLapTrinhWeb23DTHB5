@model IEnumerable<WebBanHang.Models.Product>
@{
    ViewData["Title"] = "TechShop - Đỉnh Cao Công Nghệ";
    int numOfQuantity = 1;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<div id="techShopCarousel" class="carousel slide carousel-fade shadow-sm mb-5" data-bs-ride="carousel">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#techShopCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
        <button type="button" data-bs-target="#techShopCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
    </div>
    <div class="carousel-inner rounded-4 overflow-hidden" style="height: 320px;">
        <div class="carousel-item active h-100" data-bs-interval="4000" style="background: linear-gradient(135deg, #111827 0%, #1f2937 100%);">
            <div class="container h-100 d-flex align-items-center">
                <div class="row w-100 align-items-center m-0">
                    <div class="col-md-7 text-white ps-4 animate__animated animate__fadeInLeft">
                        <span class="badge bg-warning text-dark fw-bold mb-2 text-uppercase px-3 py-1.5 rounded-pill">⚡ SIÊU DEAL ĐỘC QUYỀN</span>
                        <h1 class="fw-black text-uppercase m-0 lh-sm" style="font-size: 2.2rem;">LAPTOP GAMING<br><span class="text-warning">GIẢM SỐC 30%</span></h1>
                        <p class="text-white-50 my-3 small">Trải nghiệm cấu hình tối thượng, chiến mượt mọi tựa game đồ họa nặng.</p>
                        <a href="#store-section" class="btn btn-warning btn-md rounded-pill fw-bold px-4 shadow">Mua Ngay <i class="bi bi-arrow-right"></i></a>
                    </div>
                    <div class="col-md-5 text-center d-none d-md-block text-warning opacity-25">
                        <i class="bi bi-laptop" style="font-size: 10rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="carousel-item h-100" data-bs-interval="4000" style="background: linear-gradient(135deg, #0f172a 0%, #334155 100%);">
            <div class="container h-100 d-flex align-items-center">
                <div class="row w-100 align-items-center m-0">
                    <div class="col-md-7 text-white ps-4 animate__animated animate__fadeInLeft">
                        <span class="badge bg-info text-white fw-bold mb-2 text-uppercase px-3 py-1.5 rounded-pill">🚀 NEW ARRIVAL</span>
                        <h1 class="fw-black text-uppercase m-0 lh-sm" style="font-size: 2.2rem;">SMARTPHONE 5G<br><span class="text-info">THẾ HỆ MỚI</span></h1>
                        <p class="text-white-50 my-3 small">Bắt trọn mọi khoảnh khắc đỉnh cao với hệ thống camera siêu nét.</p>
                        <a href="#store-section" class="btn btn-info text-white btn-md rounded-pill fw-bold px-4 shadow">Khám Phá <i class="bi bi-arrow-right"></i></a>
                    </div>
                    <div class="col-md-5 text-center d-none d-md-block text-info opacity-25">
                        <i class="bi bi-phone" style="font-size: 10rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container mb-5">
    <div class="row g-3 text-center">
        <div class="col-md-4">
            <div class="p-3 bg-white shadow-sm rounded-3 d-flex align-items-center justify-content-center gap-3 border-start border-warning border-4 h-100">
                <i class="bi bi-truck text-warning fs-2"></i>
                <div class="text-start">
                    <h6 class="fw-bold m-0 text-dark small">Giao Hàng Hỏa Tốc</h6>
                    <small class="text-muted" style="font-size: 0.8rem;">Nội thành trong 2 giờ</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3 bg-white shadow-sm rounded-3 d-flex align-items-center justify-content-center gap-3 border-start border-success border-4 h-100">
                <i class="bi bi-shield-check text-success fs-2"></i>
                <div class="text-start">
                    <h6 class="fw-bold m-0 text-dark small">Chính Hãng 100%</h6>
                    <small class="text-muted" style="font-size: 0.8rem;">Bảo hành toàn quốc 12 tháng</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3 bg-white shadow-sm rounded-3 d-flex align-items-center justify-content-center gap-3 border-start border-danger border-4 h-100">
                <i class="bi bi-arrow-counterclockwise text-danger fs-2"></i>
                <div class="text-start">
                    <h6 class="fw-bold m-0 text-dark small">Đổi Trả Dễ Dàng</h6>
                    <small class="text-muted" style="font-size: 0.8rem;">Lỗi 1 đổi 1 trong 30 ngày</small>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container mb-5" id="store-section">
    <div class="d-flex align-items-center gap-2 mb-4">
        <div class="bg-warning rounded" style="width: 6px; height: 28px;"></div>
        <h3 class="fw-black text-dark text-uppercase m-0 tracking-wide" style="font-size: 1.4rem;">🔥 Sản Phẩm Nổi Bật</h3>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3">
        @if (Model != null && Model.Any())
        {
            foreach (var product in Model)
            {
                <div class="col">
                    <div class="card h-100 border-0 rounded-3 shadow-sm bg-white overflow-hidden d-flex flex-column hover-premium">

                        <span class="position-absolute top-0 start-0 badge bg-dark bg-opacity-75 text-warning fw-bold m-2 px-2 py-1 rounded shadow-sm z-index-2" style="font-size: 0.7rem;">
                            <i class="bi bi-tag-fill me-1"></i>@(product.Category?.Name ?? "Hi-Tech")
                        </span>

                        <div class="bg-light d-flex align-items-center justify-content-center border-bottom overflow-hidden position-relative" style="height: 180px; min-height: 180px;">
                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl" alt="@product.Name" class="img-fluid img-cover-effect w-100 h-100" style="object-fit: cover;" />
                            }
                            else
                            {
                                <div class="text-muted text-center">
                                    <i class="bi bi-cpu fs-1 text-secondary"></i>
                                    <span class="d-block small mt-1">Chưa có ảnh</span>
                                </div>
                            }
                        </div>

                        <div class="card-body p-3 d-flex flex-column flex-grow-1">
                            <h6 class="fw-bold text-dark text-line-2 mb-2 lh-base text-start" style="height: 40px; font-size: 0.92rem;" title="@product.Name">
                                @product.Name
                            </h6>

                            <p class="text-muted small text-line-2 text-start mb-3" style="height: 34px; font-size: 0.8rem; line-height: 1.4;">
                                @product.Description
                            </p>

                            <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                                <span class="text-muted" style="font-size: 0.75rem;">Giá ưu đãi:</span>
                                <span class="fw-black text-danger fs-5">@product.Price.ToString("#,##0") <span style="font-size: 0.8rem; font-weight: normal;">đ</span></span>
                            </div>
                        </div>

                        <div class="card-footer bg-white border-0 p-3 pt-0">
                            <div class="row g-2">
                                <div class="col-9">
                                    <a asp-controller="ShoppingCart" asp-action="AddToCart"
                                       asp-route-productId="@product.Id"
                                       asp-route-quantity="@numOfQuantity"
                                       class="btn btn-warning w-100 text-dark fw-bold btn-sm rounded-2 py-2 d-flex align-items-center justify-content-center gap-1 btn-main-buy shadow-sm">
                                        <i class="bi bi-bag-plus-fill"></i> MUA NGAY
                                    </a>
                                </div>
                                <div class="col-3">
                                    <a asp-action="Display" asp-route-id="@product.Id" class="btn btn-outline-dark btn-sm w-100 py-2 d-flex align-items-center justify-content-center shadow-sm" title="Xem chi tiết">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 w-100 text-center py-5 text-muted shadow-sm bg-white rounded-3">
                <i class="bi bi-folder-x fs-1 text-warning d-block mb-2"></i>
                <p class="m-0 fw-semibold">Sản phẩm đang được cập nhật, vui lòng quay lại sau!</p>
            </div>
        }
    </div>
</div>

<style>
    .fw-black {
        font-weight: 800 !important;
    }

    .z-index-2 {
        z-index: 2;
    }

    .tracking-wide {
        letter-spacing: 0.5px;
    }

    /* ÉP BUỘC CHỮ CHỈ HIỂN THỊ TỐI ĐA 2 DÒNG, TỰ ĐỘNG THÊM DẤU "..." NẾU DÀI HƠN */
    .text-line-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: normal;
    }

    /* HIỆU ỨNG CHUYỂN ĐỘNG CAO CẤP */
    .hover-premium {
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .hover-premium:hover {
            transform: translateY(-5px);
            box-shadow: 0 0.75rem 1.5rem rgba(0, 0, 0, 0.1) !important;
        }

    .img-cover-effect {
        transition: transform 0.4s ease;
    }

    .hover-premium:hover .img-cover-effect {
        transform: scale(1.05);
    }

    .btn-main-buy {
        transition: background-color 0.2s ease;
    }

        .btn-main-buy:hover {
            background-color: #e68a00 !important;
        }
</style>