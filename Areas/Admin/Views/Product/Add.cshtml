@model WebBanHang.Models.Product

@{
    ViewData["Title"] = "Thêm Sản Phẩm Mới";
}

<div class="container my-5" style="max-width: 800px;">
    <div class="card shadow border-0 rounded-4 p-4">
        <h3 class="fw-bold text-dark border-bottom pb-3 mb-4"><i class="bi bi-plus-circle text-warning me-2"></i>Thêm Sản Phẩm Mới</h3>

        <form asp-action="Add" method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold">Tên sản phẩm</label>
                <input asp-for="Name" class="form-control rounded-3" required />
            </div>
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Price" class="form-label fw-semibold">Giá bán (đ)</label>
                    <input asp-for="Price" type="number" class="form-control rounded-3" required />
                </div>
                <div class="col-md-6">
                    <label asp-for="CategoryId" class="form-label fw-semibold">Danh mục sản phẩm</label>
                    <select asp-for="CategoryId" asp-items="ViewBag.CategoryList" class="form-select rounded-3" required>
                        <option value="">-- Chọn danh mục --</option>
                    </select>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-semibold">Mô tả sản phẩm</label>
                <textarea asp-for="Description" rows="4" class="form-control rounded-3"></textarea>
            </div>
            <div class="mb-4">
                <label class="form-label fw-semibold">Hình ảnh đại diện</label>
                <input type="file" name="file" class="form-control rounded-3" accept="image/*" />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning text-dark fw-bold rounded-pill px-4">Lưu Sản Phẩm</button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Hủy Bỏ</a>
            </div>
        </form>
    </div>
</div>