@model IEnumerable<WebBanHang.Models.Product>

@{
    ViewData["Title"] = "Quản Lý Sản Phẩm";
}

<div class="container my-5">
    <div class="row mb-4 align-items-center">
        <div class="col-md-6">
            <h2 class="fw-bold text-dark m-0"><i class="bi bi-kanban-fill text-warning me-2"></i>Quản Lý Sản Phẩm</h2>
            <p class="text-muted small m-0">Phân hệ dành riêng cho Quản trị viên hệ thống TECH SHOP</p>
        </div>
        <div class="col-md-6 text-md-end mt-3 mt-md-0">
            <a asp-area="Admin" asp-controller="Product" asp-action="Add" class="btn btn-warning rounded-pill px-4 text-dark fw-bold shadow-sm">
                <i class="bi bi-plus-circle-fill me-2"></i> Thêm Sản Phẩm Mới
            </a>
        </div>
    </div>

    <div class="card shadow border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark text-uppercase small">
                        <tr>
                            <th class="ps-4 py-3" style="width: 120px;">Hình Ảnh</th>
                            <th class="py-3">Tên Sản Phẩm</th>
                            <th class="py-3">Giá Bán</th>
                            <th class="py-3">Mô Tả</th>
                            <th class="text-center py-3 pe-4" style="width: 200px;">Hành Động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-box-seam d-block fs-2 mb-2"></i>
                                    Kho hàng hiện tại đang trống.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <img src="@item.ImageUrl" class="img-thumbnail rounded-3 shadow-sm" style="width: 65px; height: 65px; object-fit: cover;" />
                                    </td>
                                    <td class="fw-bold text-dark py-3">@item.Name</td>
                                    <td class="text-danger fw-semibold py-3">@item.Price.ToString("#,##0") đ</td>
                                    <td class="text-muted small py-3" style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                        @item.Description
                                    </td>
                                    <td class="text-center py-3 pe-4">
                                        <div class="d-inline-flex gap-2">
                                            <a asp-area="Admin" asp-controller="Product" asp-action="Update" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary rounded-3 px-3">
                                                Sửa
                                            </a>
                                            <a asp-area="Admin" asp-controller="Product" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-3 px-3">
                                                Xóa
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>