@model WebBanHang.Models.Product

@{
    ViewData["Title"] = "Cập Nhật Sản Phẩm";
}

<div class="container my-5" style="max-width: 800px;">
    <div class="card shadow border-0 rounded-4 p-4">
        <h3 class="fw-bold text-dark border-bottom pb-3 mb-4"><i class="bi bi-pencil-square text-warning me-2"></i>Cập Nhật Sản Phẩm</h3>

        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ImageUrl" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold">Tên sản phẩm</label>
                <input asp-for="Name" class="form-control rounded-3" required />
            </div>
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Price" class="form-label fw-semibold">Giá bán (đ)</label>
                    <input asp-for="Price" type="number" class="form-control rounded-3" required />
                </div>
                <div class="col-md-6">
                    <label asp-for="CategoryId" class="form-label fw-semibold">Danh mục sản phẩm</label>
                    <select asp-for="CategoryId" asp-items="ViewBag.CategoryList" class="form-select rounded-3" required></select>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-semibold">Mô tả sản phẩm</label>
                <textarea asp-for="Description" rows="4" class="form-control rounded-3"></textarea>
            </div>
            <div class="row align-items-center mb-4">
                <div class="col-md-9">
                    <label class="form-label fw-semibold">Thay đổi hình ảnh mới</label>
                    <input type="file" name="file" class="form-control rounded-3" accept="image/*" />
                </div>
                <div class="col-md-3 text-center mt-3 mt-md-0">
                    <span class="d-block small text-muted mb-1">Ảnh hiện tại</span>
                    <img src="@Model.ImageUrl" class="img-thumbnail rounded-3 shadow-sm" style="width: 75px; height: 75px; object-fit: cover;" />
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning text-dark fw-bold rounded-pill px-4">Cập Nhật</button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Quay Lại</a>
            </div>
        </form>
    </div>
</div>