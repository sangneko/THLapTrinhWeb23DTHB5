@model IEnumerable<WebBanHang.Models.Order>

@{
    ViewData["Title"] = "Quản Lý Đơn Hàng - Admin";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-receipt-cutoff text-warning me-2"></i>Quản Lý Đơn Hàng
            </h2>
            <p class="text-muted small mb-0">Hệ thống theo dõi, xử lý và cập nhật trạng thái đơn hàng của hệ thống TECH SHOP</p>
        </div>
        <span class="badge bg-dark text-warning rounded-pill px-3 py-2 fw-semibold shadow-sm">
            Tổng số đơn: @Model?.Count()
        </span>
    </div>

    <div class="card shadow border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark text-uppercase small">
                        <tr>
                            <th class="ps-4 py-3" style="width: 100px;">Mã ĐH</th>
                            <th class="py-3">Khách Hàng</th>
                            <th class="py-3">Ngày Đặt Đơn</th>
                            <th class="py-3">Tổng Giá Trị</th>
                            <th class="py-3" style="width: 160px;">Trạng Thái</th>
                            <th class="text-center py-3 pe-4" style="width: 150px;">Hành Động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox d-block fs-1 mb-2 text-secondary"></i>
                                    Hệ thống hiện tại chưa ghi nhận đơn đặt hàng nào.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 py-3 fw-bold text-secondary">#@item.Id</td>
                                    <td class="py-3">
                                        <div class="fw-bold text-dark">@item.ApplicationUser?.FullName</div>
                                        <span class="text-muted small">@item.ApplicationUser?.Email</span>
                                    </td>
                                    <td class="py-3 text-muted">@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-danger fw-bold py-3">@item.TotalAmount.ToString("#,##0") đ</td>
                                    <td class="py-3">
                                        @if (item.OrderStatus == "Đã giao")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success rounded-pill px-3 py-2 w-100 text-center fw-semibold">
                                                <i class="bi bi-check-circle-fill me-1"></i> Đã giao
                                            </span>
                                        }
                                        else if (item.OrderStatus == "Đang giao")
                                        {
                                            <span class="badge bg-info-subtle text-info border border-info rounded-pill px-3 py-2 w-100 text-center fw-semibold">
                                                <i class="bi bi-truck me-1"></i> Đang giao
                                            </span>
                                        }
                                        else if (item.OrderStatus == "Đã hủy")
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger rounded-pill px-3 py-2 w-100 text-center fw-semibold">
                                                <i class="bi bi-x-circle-fill me-1"></i> Đã hủy
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning rounded-pill px-3 py-2 w-100 text-center fw-semibold">
                                                <i class="bi bi-hourglass-split me-1"></i> Đang xử lý
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center py-3 pe-4">
                                        <a asp-area="Admin" asp-controller="Order" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-warning text-dark rounded-3 px-3 fw-bold shadow-sm">
                                            <i class="bi bi-eye-fill me-1"></i> Chi Tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>