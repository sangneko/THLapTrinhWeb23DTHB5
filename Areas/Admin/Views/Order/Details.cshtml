@model WebBanHang.Models.Order

@{
    ViewData["Title"] = "Chi Tiết Đơn Hàng";
}

<div class="container my-5">
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill mb-2"><i class="bi bi-arrow-left"></i> Quay lại</a>
        <h2 class="fw-bold text-dark m-0">Chi Tiết Đơn Hàng #@Model.Id</h2>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card shadow border-0 rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">Thông Tin Giao Hàng</h5>
                    <p class="small mb-2"><strong>Khách hàng:</strong> @Model.ApplicationUser?.FullName</p>
                    <p class="small mb-2"><strong>Email:</strong> @Model.ApplicationUser?.Email</p>
                    <p class="small mb-2"><strong>Địa chỉ nhận:</strong> @Model.ShippingAddress</p>
                    <p class="small mb-0"><strong>Ngày tạo đơn:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
            </div>

            <div class="card shadow border-0 rounded-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">Xử Lý Đơn Hàng</h5>
                    <form asp-action="UpdateStatus" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="mb-3">
                            <select name="status" class="form-select rounded-3">
                                <option value="Đang xử lý" selected="@(Model.OrderStatus == "Đang xử lý")">Đang xử lý</option>
                                <option value="Đang giao" selected="@(Model.OrderStatus == "Đang giao")">Đang giao</option>
                                <option value="Đã giao" selected="@(Model.OrderStatus == "Đã giao")">Đã giao</option>
                                <option value="Đã hủy" selected="@(Model.OrderStatus == "Đã hủy")">Đã hủy</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-warning w-100 rounded-pill text-dark fw-bold">Cập Nhật Trạng Thái</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow border-0 rounded-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">Danh Sách Mặt Hàng</h5>
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr class="text-secondary small text-uppercase">
                                    <th>Sản Phẩm</th>
                                    <th class="text-center">Số Lượng</th>
                                    <th class="text-end">Đơn Giá</th>
                                    <th class="text-end">Thành Tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderDetails)
                                {
                                    <tr>
                                        <td class="fw-bold text-dark">@item.Product?.Name</td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-end">@item.Price.ToString("#,##0") đ</td>
                                        <td class="text-end text-danger fw-semibold">@((item.Quantity * item.Price).ToString("#,##0")) đ</td>
                                    </tr>
                                }
                                <tr class="table-light fw-bold">
                                    <td colspan="3" class="text-end text-dark">TỔNG GIÁ TRỊ ĐƠN HÀNG:</td>
                                    <td class="text-end text-danger fs-5">@Model.TotalAmount.ToString("#,##0") đ</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>